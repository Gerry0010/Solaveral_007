# Copia este archivo como .env y llena tus datos. NUNCA subas .env al repositorio.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia_esto
DB_NAME=solareval
# Para bases en la nube (Neon, Supabase, Render) usa: require
DB_SSLMODE=prefer
# Cadena larga y secreta para firmar los tokens de sesión
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
# Llave de Google Solar API (Google Cloud). Si está vacía, se usa el modo demostración.
SOLAR_API_KEY=
# true = estimación de demostración sin llamar a la Solar API
MODO_DEMO=false
